{
  "name": "linkedin-fonts",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension (Chrome + Firefox) that adds Bold, Italic and Underline to LinkedIn text fields using Unicode characters.",
  "license": "MIT",
  "author": "Francesco Napoletano <napolux@gmail.com>",
  "homepage": "https://github.com/napolux/linkedin-fonts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/napolux/linkedin-fonts.git"
  },
  "bugs": {
    "url": "https://github.com/napolux/linkedin-fonts/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs --target all",
    "build:chrome": "node scripts/build.mjs --target chrome",
    "build:firefox": "node scripts/build.mjs --target firefox",
    "watch": "node scripts/build.mjs --target all --watch",
    "dev:chrome": "web-ext run --target chromium --source-dir dist/chrome --start-url https://www.linkedin.com/feed/",
    "dev:firefox": "web-ext run --target firefox-desktop --source-dir dist/firefox --start-url https://www.linkedin.com/feed/",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "npm run build:chrome && node --test --test-concurrency=1 \"test/e2e/*.e2e.mjs\"",
    "lint": "npm run lint:js && npm run lint:firefox",
    "lint:js": "eslint .",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "package": "npm run build && npm run package:chrome && npm run package:firefox",
    "package:chrome": "web-ext build --source-dir dist/chrome --artifacts-dir artifacts --filename \"linkedin-fonts-chrome-{version}.zip\" --overwrite-dest",
    "package:firefox": "web-ext build --source-dir dist/firefox --artifacts-dir artifacts --filename \"linkedin-fonts-firefox-{version}.zip\" --overwrite-dest",
    "package:source": "node scripts/package-source.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "web-ext": "^10.8.0"
  }
}
