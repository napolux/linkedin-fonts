{
  "manifest_version": 3,
  "name": "Fonts for LinkedIn",
  "short_name": "LinkedIn Fonts",
  "description": "Bold, italic and underline for LinkedIn posts, comments and messages, using Unicode characters.",
  "homepage_url": "https://github.com/napolux/linkedin-fonts",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
